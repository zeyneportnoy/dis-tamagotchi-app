{
  "name": "dis-tamagotchi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "db:migrate": "jest --runInBand src/data/db/__tests__/migrations.test.ts",
    "db:verify": "jest --runInBand src/data/db/__tests__/database.test.ts",
    "smoke:export": "npm run smoke:ios && npm run smoke:android",
    "smoke:ios": "expo export --platform ios --output-dir dist/ios",
    "smoke:android": "expo export --platform android --output-dir dist/android",
    "build:preview": "eas build --profile preview --platform all",
    "test:e2e": "echo 'E2E starts in a later milestone'"
  },
  "dependencies": {
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
