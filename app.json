{
  "expo": {
    "name": "DentHero",
    "slug": "dis-tamagotchi",
    "owner": "zeyneportnoy",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "distamagotchi",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D9D3F6",
          "image": "./assets/splash/denthero-splash.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.distamagotchi.app",
      "buildNumber": "11",
      "infoPlist": {
        "CFBundleDisplayName": "DentHero",
        "CFBundleName": "DentHero"
      }
    },
    "android": {
      "package": "com.distamagotchi.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F4"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8d021c6e-d18f-49a7-80b8-45ad2192657f"
      }
    }
  }
}
