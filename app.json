{
  "expo": {
    "name": "DentHero",
    "slug": "dis-tamagotchi",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "distamagotchi",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DADAF7",
          "image": "./assets/splash/denthero-splash.png",
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.distamagotchi.app",
      "infoPlist": {
        "CFBundleDisplayName": "DentHero",
        "CFBundleName": "DentHero"
      }
    },
    "android": {
      "package": "com.distamagotchi.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F4"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
